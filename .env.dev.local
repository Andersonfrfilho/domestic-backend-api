### ENVS TO USE APP

### APP
PROJECT_NAME=backend
PORT=3333

### DATABASE RELATED
DATABASE_POSTGRES_PORT=5433
DATABASE_POSTGRES_NAME=backend_database_postgres
DATABASE_POSTGRES_HOST=localhost
DATABASE_POSTGRES_USER=domestic_api
DATABASE_POSTGRES_PASSWORD=domestic123
DATABASE_POSTGRES_SYNCHRONIZE=false
DATABASE_POSTGRES_LOGGING=true
DATABASE_POSTGRES_TIMEZONE=Z

### DATABASE TEST E2E RELATED
DATABASE_POSTGRES_TEST_E2E_PORT=5432
DATABASE_POSTGRES_TEST_E2E_NAME=backend_database_postgres_test_e2e
DATABASE_POSTGRES_TEST_E2E_HOST=database_postgres
DATABASE_POSTGRES_TEST_E2E_USER=postgres
DATABASE_POSTGRES_TEST_E2E_PASSWORD=postgres1234
DATABASE_POSTGRES_TEST_E2E_SYNCHRONIZE=false
DATABASE_POSTGRES_TEST_E2E_LOGGING=false
DATABASE_POSTGRES_TEST_E2E_TIMEZONE=Z

### MONGO DB
DATABASE_MONGO_PORT=27017
DATABASE_MONGO_HOST=localhost
DATABASE_MONGO_USERNAME=mongo
DATABASE_MONGO_PASSWORD=mongo1234
MONGO_URI=mongodb://localhost:27017/backend_database_mongo

### MONGO DB TEST E2E
MONGO_URI_TEST_E2E=mongodb://database_mongo:27017/backend_database_mongo_test_e2e

### SONARQUBE
SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=
SONAR_PROJECT_KEY=domestic-backend-api

### Fortify
FORTIFY_BUILD_ID=domestic-backend-api
FORTIFY_OUTPUT=fortify-report.fpr
FORTIFY_SSC_URL=https://fortify.seuservidor.com
FORTIFY_SSC_TOKEN=seu-token-fortify

### CACHE - REDIS
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379

### QUEUE RABBITMQ (optional for local dev)
QUEUE_RABBITMQ_PORT=5672
QUEUE_RABBITMQ_MANAGEMENT_PORT=15672
QUEUE_RABBITMQ_USER=backend-api
QUEUE_RABBITMQ_PASS=backendapi123
QUEUE_RABBITMQ_HOST=localhost

### STORAGE (MinIO)
STORAGE_MINIO_ENDPOINT=localhost
STORAGE_MINIO_PORT=9020
STORAGE_MINIO_ACCESS_KEY=minioadmin
STORAGE_MINIO_SECRET_KEY=minioadmin
STORAGE_MINIO_BUCKET=documents
STORAGE_MINIO_USE_SSL=false

### DATADOG (optional for local dev)
DD_ENV=development
DD_SERVICE=domestic-backend-api
DD_VERSION=1.0.0
DD_AGENT_HOST=datadog
DD_TRACE_AGENT_PORT=8126
DD_LOGS_INJECTION=true
DD_PROFILING_ENABLED=true
DD_APPSEC_ENABLED=true
DD_IAST_ENABLED=true

### KEYCLOAK (optional for local dev)
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_REALM=domestic-backend
KEYCLOAK_CLIENT_ID=domestic-api
KEYCLOAK_CLIENT_SECRET=api-client-secret
KEYCLOAK_BASE_URL=http://localhost:8080

# K8s credentials removed — use only for k8s deploys, not local dev