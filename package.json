{
  "name": "backend-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky install",
    "build": "nest build --config tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:dev:local": "cp .env.dev.local .env && npm run start:dev",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings 0",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:imports": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix --rule 'import/order: error'",
    "format:all": "npm run format && npm run lint",
    "test:unit": "jest --config jest.config.unit.ts",
    "test:unit:watch": "jest --watch --config jest.config.unit.ts",
    "test:unit:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config jest.config.unit.ts",
    "test:unit:cov": "jest --coverage --config jest.config.unit.ts",
    "test:e2e:migration": "NODE_ENV=test npm run migration:run",
    "test:e2e": "jest --config jest.config.e2e.ts",
    "test:e2e:watch": "jest --watch --config jest.config.e2e.ts",
    "test:all": "npm run test:unit && npm run test:e2e",
    "sonar": "sonar-scanner",
    "migration:show": "node scripts/migration.js show",
    "migration:run": "node scripts/migration.js run",
    "migration:revert": "node scripts/migration.js revert",
    "migration:generate": "node scripts/migration.js generate",
    "test:e2e:ci": "USE_TEST_CONTAINERS=true DOTENV_CONFIG_PATH=.env.e2e.ci jest --config jest.config.e2e.ts --runInBand",
    "run:api-curls": "node scripts/api-curl-tester.js",
    "flows": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts",
    "flows:user": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts user",
    "flows:phone": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts phone",
    "flows:email": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts email",
    "flows:health": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts health",
    "flows:category": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts category",
    "flows:service": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts service",
    "flows:provider": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts provider",
    "flows:service-request": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts service-request",
    "flows:review": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts review",
    "flows:document": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts document",
    "flows:notification": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/flows/index.ts notification",
    "seed": "DOTENV_CONFIG_PATH=.env.dev.local ts-node -r tsconfig-paths/register -r dotenv/config scripts/seeds/index.ts"
  },
  "lint-staged": {
    "{src,apps,libs,test}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@adatechnology/auth-keycloak": "^0.1.14",
    "@adatechnology/cache": "^0.0.17",
    "@adatechnology/http-client": "^0.0.21",
    "@adatechnology/keycloak-admin": "^0.1.13",
    "@adatechnology/logger": "^0.0.17",
    "@faker-js/faker": "^10.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.1.3",
    "@golevelup/nestjs-rabbitmq": "^7.1.1",
    "@nestjs-redis/kit": "^0.13.3",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.7",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@willsoto/nestjs-prometheus": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "csurf": "^1.11.0",
    "ioredis": "^5.9.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "mongodb": "^6.21.0",
    "nest-winston": "^1.10.2",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.27",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.9",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.4.2",
    "sonarqube-scanner": "^4.3.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "file-type": ">=21.3.2",
    "uuid": ">=11.1.1",
    "cookie": ">=0.7.0",
    "axios": ">=1.15.2"
  }
}
